# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase & Data Connect Configuration
FIREBASE_PROJECT_ID=astra-dev-project
FIREBASE_SERVICE_ACCOUNT_JSON=./serviceAccountKey.json
DATA_CONNECT_SERVICE_ID=astra-dataconnect
DATA_CONNECT_LOCATION=us-central1
DATA_CONNECT_CONNECTOR=default

# Authentication & QR Tokens
JWT_SECRET=placeholder-jwt-secret-key-change-in-production
QR_SIGNING_SECRET=placeholder-qr-signing-secret-change-in-production

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=astra-sheets@astra-dev-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDplaceholder\n-----END PRIVATE KEY-----\n"
MEMBERS_SHEET_ID=placeholder-members-google-sheet-id
PAID_SHEET_ID=placeholder-paid-google-sheet-id
OPPORTUNITIES_SHEET_ID=placeholder-opportunities-google-sheet-id

# Attendance Configuration
ATTENDANCE_POINTS=10

# Basty: member connection / verification (CSV is synthetic local data only)
MEMBER_DATA_SOURCE=csv
MEMBERS_CSV_PATH=data/member_sheet.csv
PAID_CSV_PATH=data/paid_sheet.csv
MEMBERS_SR_COLUMN=sr_code
MEMBERS_NAME_COLUMN=full_name
PAID_SR_COLUMN=sr_code
# For real checks, select google-sheets and configure the existing Sheets keys
# and IDs above. Include the header row in each worksheet range.
MEMBERS_SHEET_RANGE=Sheet1!A1:Z
PAID_SHEET_RANGE=Sheet1!A1:Z
